{
  "name": "animabing-backend",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat", "no_handle_cross_request_promise_resolution"],
  "workers_dev": true,
  "preview_urls": true,
  "placement": { "mode": "smart" },
  "vars": {
    "MONGODB_DB": "animabing",
    "ALLOWED_ORIGIN": "*",
    "API_URL": "https://animabing-backend.animabingwatch.workers.dev",
    "FRONTEND_URL": "https://animebing.in"
  },
  "queues": {
    "producers": [
      { "queue": "pageview-queue", "binding": "PAGEVIEW_QUEUE" }
    ],
    "consumers": [
      {
        "queue": "pageview-queue",
        "max_batch_size": 50,
        "max_batch_timeout": 20,
        "max_retries": 3
      }
    ]
  },
  "triggers": {
    "crons": ["30 2,14 * * *", "*/5 * * * *", "10 0 * * *", "40 18 * * *"]
  },
  "routes": [
    {
      "pattern": "animebing.in/api/*",
      "zone_name": "animebing.in"
    },
    {
      "pattern": "animebing.in/robots.txt",
      "zone_name": "animebing.in"
    },
    {
      "pattern": "animebing.in/sitemap*",
      "zone_name": "animebing.in"
    },
    {
      "pattern": "go.animebing.in",
      "zone_name": "animebing.in",
      "custom_domain": true
    }
  ]
}