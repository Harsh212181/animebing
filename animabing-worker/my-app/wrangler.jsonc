{
  "name": "animabing-backend",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat", "no_handle_cross_request_promise_resolution"],
  "workers_dev": true,
  "preview_urls": true,

  // Run the Worker close to the MongoDB Atlas cluster (assumes Atlas is AWS Mumbai).
  // If your Atlas region is different, change this value (e.g. "aws:us-east-1", "gcp:asia-south1").
  // To go back to the old behavior, use: "placement": { "mode": "smart" }
  "placement": { "region": "aws:ap-south-1" },

  "vars": {
    "MONGODB_DB": "animabing",
    "ALLOWED_ORIGIN": "*",
    "API_URL": "https://animabing-backend.animabingwatch.workers.dev",
    "FRONTEND_URL": "https://animebing.in"
  },
  "queues": {
    "producers": [
      { "queue": "pageview-queue", "binding": "PAGEVIEW_QUEUE" }
    ],
    "consumers": [
      {
        "queue": "pageview-queue",
        "max_batch_size": 50,
        "max_batch_timeout": 20,
        "max_retries": 3
      }
    ]
  },
  "triggers": {
    "crons": ["30 2,14 * * *", "*/5 * * * *", "10 0 * * *", "40 18 * * *", "0 3 * * *"]
  },
  "routes": [
    {
      "pattern": "animebing.in/api/*",
      "zone_name": "animebing.in"
    },
    {
      "pattern": "animebing.in/robots.txt",
      "zone_name": "animebing.in"
    },
    {
      "pattern": "animebing.in/sitemap*",
      "zone_name": "animebing.in"
    },
    {
      "pattern": "go.animebing.in",
      "zone_name": "animebing.in",
      "custom_domain": true
    }
  ]
}